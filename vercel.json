{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": null,
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/specs/meta-wondersteva-:id",
      "destination": "/specs/meta-wonders-teva-:id",
      "permanent": true
    },
    {
      "source": "/specs/raw/meta-wondersteva-:id",
      "destination": "/specs/raw/meta-wonders-teva-:id",
      "permanent": true
    }
  ]
}